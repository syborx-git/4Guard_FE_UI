# =============================================================================
# 4GUARD WMS — Plantilla Nginx del Host en Hetzner (Reverse Proxy HTTPS -> Docker)
# =============================================================================
# Instrucciones de despliegue en el servidor Hetzner:
#   1. Copiar este archivo a /etc/nginx/sites-available/4guard-wms.conf
#   2. Reemplazar los dominios (admin.4guard.example.com / rf.4guard.example.com)
#      y las rutas de certificados SSL (Let's Encrypt / Certbot).
#   3. Habilitar el sitio:
#        sudo ln -s /etc/nginx/sites-available/4guard-wms.conf /etc/nginx/sites-enabled/4guard-wms.conf
#   4. Validar y recargar Nginx:
#        sudo nginx -t && sudo systemctl reload nginx
#
# Puertos locales expuestos por Docker (ver docker-compose.yml):
#   - 127.0.0.1:8081 -> Admin Console (Nginx contenedor :8080)
#   - 127.0.0.1:8082 -> RF Terminal   (Nginx contenedor :8081)
# =============================================================================

# Mapa requerido para upgrade de WebSocket STOMP (RFC 6455)
# Nota: Si ya existe este map en /etc/nginx/nginx.conf, elimina o comenta este bloque.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ─────────────────────────────────────────────────────────────────────────────
# Redirección HTTP (80) -> HTTPS (443)
# ─────────────────────────────────────────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name admin.4guard.example.com rf.4guard.example.com;

    # Soporte para renovación automática ACME (Certbot)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ─────────────────────────────────────────────────────────────────────────────
# 1. ADMIN CONSOLE (HTTPS 443 -> 127.0.0.1:8081)
# ─────────────────────────────────────────────────────────────────────────────
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name admin.4guard.example.com;

    # Certificados SSL (ajustar ruta según dominio)
    ssl_certificate     /etc/letsencrypt/live/admin.4guard.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.4guard.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Límite para subida de adjuntos (evidencias, PDFs, fotos en chat/operaciones)
    client_max_body_size 10m;

    # WebSocket STOMP directo (/ws-wms)
    location /ws-wms {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # WebSocket STOMP vía prefijo API (/api/v1/ws-wms)
    location /api/v1/ws-wms {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # API REST y descarga/carga de adjuntos
    location /api/v1/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 60s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Frontend SPA Admin Console
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# ─────────────────────────────────────────────────────────────────────────────
# 2. RF TERMINAL / TABLET (HTTPS 443 -> 127.0.0.1:8082)
# ─────────────────────────────────────────────────────────────────────────────
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name rf.4guard.example.com;

    # Certificados SSL (ajustar ruta según dominio)
    ssl_certificate     /etc/letsencrypt/live/rf.4guard.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rf.4guard.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Límite para subida de adjuntos (evidencias, PDFs, fotos en chat/operaciones)
    client_max_body_size 10m;

    # WebSocket STOMP directo (/ws-wms)
    location /ws-wms {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # WebSocket STOMP vía prefijo API (/api/v1/ws-wms)
    location /api/v1/ws-wms {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # API REST y descarga/carga de adjuntos
    location /api/v1/ {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 60s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Frontend SPA / PWA RF Terminal
    location / {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
